{
    "name": "yakoffka/laravel-notification-channels-ru-store",
    "description": "RuStore push notifications channel for Laravel",
    "homepage": "https://github.com/yakoffka/laravel-notification-channels-ru-store",
    "license": "MIT",
    "authors": [
        {
            "name": "yakOffKa",
            "email": "yagithub@mail.ru",
            "homepage": "https://yakoffka.ru/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/notifications": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\RuStore\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\RuStore\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=coverage.clover",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\RuStore\\RuStoreServiceProvider"
            ]
        }
    }
}
